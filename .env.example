# --- required ---

# Neon PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require

# Secret used to sign JWTs. Use a long random value, never a placeholder.
#   openssl rand -base64 45
JWT_SECRET=

# Resend API key for OTP and password-reset email
RESEND_API_KEY=

# --- required only for manual (ID card) registration ---

# Supabase project URL, e.g. https://xxxxxxxx.supabase.co
SUPABASE_URL=
# The secret key (sb_secret_... or a legacy service_role key). Never the
# publishable/anon key — it cannot write to a private bucket.
SUPABASE_SECRET_KEY=
# Private bucket holding student ID card photos
SUPABASE_BUCKET=id-cards

# --- optional ---

# Quote any value containing spaces or <>, otherwise dotenv stops parsing
# here and every variable below it is silently ignored.
RESEND_FROM_EMAIL="SUST CP Geeks <onboarding@resend.dev>"

# Comma-separated. Defaults to localhost:5173, :4173 and :3000.
CORS_ALLOWED_ORIGINS=

PORT=8080
RUST_LOG=info,tower_http=debug
