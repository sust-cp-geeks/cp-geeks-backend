[Unit]
Description=SUST CP Geeks backend
# network-online rather than network: the process connects to neon on startup
# and dies if dns is not resolvable yet
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cpgeeks
Group=cpgeeks
WorkingDirectory=/opt/cpgeeks
ExecStart=/opt/cpgeeks/backend

# secrets live here, root-owned and 0600. never in the unit file, which is
# world-readable, and never in a .env beside the binary
EnvironmentFile=/etc/cpgeeks/backend.env

# the process deliberately panics on a missing variable or an unreachable
# database, so a restart loop is the intended signal that something is wrong.
# 5s between attempts keeps the logs readable instead of flooding them.
Restart=always
RestartSec=5

# Deliberately no StartLimitBurst/StartLimitIntervalSec. The process panics on an
# unreachable database, so crash-looping is its normal response to a transient
# neon outage. Any start limit would convert that into permanent downtime: the
# service gives up, and stays down after neon recovers, at whatever hour it
# happened. Retrying forever is the right trade for a club with nobody on call.
#
# The consequence is that this unit almost never enters `failed`, so the handler
# below is a long shot rather than real coverage. Knowing the API is down needs
# an external uptime check — see docs/backups.md.
OnFailure=cpgeeks-alert@%n.service

# hardening: the service needs no privileges, no home directories, and writes
# nowhere. if it is ever compromised this limits what it can reach.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
